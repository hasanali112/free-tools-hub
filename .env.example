# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID (leave empty to disable analytics)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Adsterra (leave empty to disable). Copy values from your Adsterra ad codes.
# Native Banner: the script src and the container id from the code snippet.
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=
NEXT_PUBLIC_ADSTERRA_NATIVE_CONTAINER=
# Optional second native banner unit for the in-content slot (Adsterra needs one unit per slot).
NEXT_PUBLIC_ADSTERRA_NATIVE2_SRC=
NEXT_PUBLIC_ADSTERRA_NATIVE2_CONTAINER=
# Social Bar: the script src from the code snippet.
NEXT_PUBLIC_ADSTERRA_SOCIALBAR_SRC=
